# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored (it can hold ids you'd rather
# not commit). None of the *secret values* live here — those are random-generated by Terraform.

project_id      = "poker-online-dev"
region          = "us-central1"
billing_account = "XXXXXX-XXXXXX-XXXXXX" # gcloud billing accounts list

# Set after Step 2 (build + push). Until then any valid ref works for `plan`.
image = "us-central1-docker.pkg.dev/poker-online-dev/poker/poker-server:latest"

# Leave as-is for the FIRST apply. After it, run `terraform output service_url`
# and paste the value here, then apply again (Step 4).
# service_url = "https://poker-server-xxxxxxxxxx-uc.a.run.app"

# max_instances = 3
# budget_amount = 5
